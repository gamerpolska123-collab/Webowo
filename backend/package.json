{
  "name": "webowo-backend",
  "version": "2.0.0",
  "description": "Backend API dla Webowo v2.0 – Enterprise Landing Page & CMS (Etap 5)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/index.js migrate",
