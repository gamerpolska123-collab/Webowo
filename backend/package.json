{
  "name": "webowo-backend",
  "version": "3.0.0",
  "description": "Webowo v3.0 Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/reset.js",
    "backup": "node jobs/backup.cron.js --manual"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "better-sqlite3": "^11.0.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "node-cron": "^3.0.3",
    "compression": "^1.7.5",
    "hpp": "^0.2.3",
    "xss-clean": "^0.1.4",
    "express-mongo-sanitize": "^2.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "nodemon": "^3.1.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": ["webowo", "cms", "api", "express", "sqlite"]
}
