# ============================================
# Webowo v3.1 – Backend Environment
# ============================================

NODE_ENV=production
PORT=3000

# Database
DB_PATH=/app/data/db/webowo.sqlite

# JWT (min 32 chars each, must be different)
JWT_SECRET=your-jwt-secret-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@webowo.pl

# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=kontakt@webowo.pl
EMAIL_TO=biuro@webowo.pl

# Uploads
UPLOAD_DIR=/app/data/uploads
UPLOAD_PUBLIC_URL=/uploads
UPLOAD_MAX_SIZE=5242880

# Backup
BACKUP_ENABLED=true
CMS_BACKUP_DIR=/app/data/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 2 * * *

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-here
CSRF_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_DIR=/app/data/logs

# CORS
CORS_ORIGIN=https://www.matys.net.pl

# Site
SITE_URL=https://www.matys.net.pl
