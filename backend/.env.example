# ============================================
# Webowo Backend v2.0 – Environment
# ============================================

PORT=6666
NODE_ENV=development

# JWT
JWT_SECRET=dev-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@webowo.pl

# Email
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM=kontakt@webowo.pl
EMAIL_TO=biuro@webowo.pl

# Backup
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30

# CORS – comma-separated list
CORS_ORIGIN=http://localhost:7777,http://192.168.1.28:7777

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Paths
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_PUBLIC_URL=/uploads
CMS_BACKUP_DIR=./data/backups
CMS_MAX_BACKUPS=20
GDPR_LOG_RETENTION_DAYS=365
GDPR_LOG_DIR=./data/logs
DB_PATH=./data/db/webowo.sqlite

JWT_ISSUER=webowo-backend
JWT_AUDIENCE=webowo-frontend
SESSION_SECRET=change-me-in-production-session-secret
CSRF_ENABLED=true
TRUST_PROXY=false
EMAIL_SUBJECT_PREFIX=[Webowo]
SMTP_POOL=false
LOG_LEVEL=debug
LOG_MAX_SIZE=20m