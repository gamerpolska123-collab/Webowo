# ============================================
# Webowo v2.0 – Environment Configuration
# ============================================

# Backend port (inside container)
PORT=3000
NODE_ENV=production

# Frontend port (host mapping)
FRONTEND_PORT=7777

# JWT (min 32 chars each – CHANGE IN PRODUCTION!)
JWT_SECRET=change-me-in-production-please-webowo-v2-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-refresh-webowo-v2-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Admin (seed only – change after first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@webowo.pl

# Email SMTP
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM=kontakt@webowo.pl
EMAIL_TO=biuro@webowo.pl

# Backup
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30

# CORS – comma-separated list of allowed origins
# Add your LAN IP here (e.g. http://192.168.1.28:7777)
CORS_ORIGIN=http://localhost:7777,http://192.168.1.28:7777

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Uploads
UPLOAD_DIR=/app/data/uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_PUBLIC_URL=/uploads

# CMS
CMS_BACKUP_DIR=/app/data/backups
CMS_MAX_BACKUPS=20

# GDPR / Logging
GDPR_LOG_RETENTION_DAYS=365
GDPR_LOG_DIR=/app/data/logs

# Database
DB_PATH=/app/data/db/webowo.sqlite
