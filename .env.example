# ============================================
# Webowo v3.1 – Environment Configuration
# ============================================
# Copy to .env and fill in your values

# JWT Secrets (min 32 chars each, MUST be different)
JWT_SECRET=your-jwt-secret-here-min-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars-diff

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-min-8-chars
ADMIN_EMAIL=admin@matys.net.pl

# Site
SITE_URL=https://www.matys.net.pl
CORS_ORIGIN=https://www.matys.net.pl

# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=kontakt@matys.net.pl
EMAIL_TO=biuro@matys.net.pl

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-here-change-me

# Backup
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
